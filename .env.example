# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_chaser

# Multi-tenant readiness (single-org for now; every table's organisationId
# column is always set to this value until an auth layer resolves it per user)
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Groq (free-tier LLM API; drafts the chase email text only — see lib/prompt.ts)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Acme Electrical <chasing@acme-electrical.co.uk>"

# Safety — see README for what these do. Never set SENDING_ENABLED=true
# in an environment where TEST_REDIRECT_EMAIL isn't set, unless you mean
# to send real email to real clients.
SENDING_ENABLED=false
TEST_REDIRECT_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authenticates the weekly-reminder cron endpoint (see vercel.json).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
